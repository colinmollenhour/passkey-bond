# Serves passkey.bond on Railway, which terminates TLS and sets $PORT.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	@www host www.passkey.bond
	redir @www https://passkey.bond{uri} permanent

	# Pages are linked without a trailing slash (/security), so send
	# /security/ there and serve the folder's index.html in place.
	@slash path_regexp slash ^(.+)/$
	redir @slash {re.slash.1} permanent
	try_files {path} {path}/index.html

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	# Fonts never change; other assets aren't fingerprinted, so stay short.
	@fonts path /assets/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@assets {
		path /assets/*
		not path /assets/fonts/*
	}
	header @assets Cache-Control "public, max-age=86400"
	@pages not path /assets/*
	header @pages Cache-Control "public, max-age=300"

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}
}
